+// Converts accumulated mouse movement into a stick deflection.
+// A stick reports velocity while a mouse reports distance, so the movement is turned into a smoothed
+// velocity (counts per millisecond), shaped with a response curve and lifted over the game's dead zone.
+void KeyboardHostListener::updateMouseStick() {
+  if (!_mouse_host_mounted || (mouseMovementMode != MOUSE_MOVEMENT_LEFT_ANALOG && mouseMovementMode != MOUSE_MOVEMENT_RIGHT_ANALOG)) {
+    return;
+  }
+
+  const uint32_t now = getMillis();
+  const uint32_t elapsed = now - mouseLastUpdate;
+  if (elapsed < 4) {
+    return; // update the stick at roughly 250 Hz
+  }
+  mouseLastUpdate = now;
+
+  const float sampleX = mouseAccX / elapsed;
+  const float sampleY = mouseAccY / elapsed;
+  mouseAccX = 0.0f;
+  mouseAccY = 0.0f;
+
+  // exponential smoothing: motion fades out smoothly instead of snapping to the centre
+  const float alpha = 0.35f;
+  mouseVelX += alpha * (sampleX - mouseVelX);
+  mouseVelY += alpha * (sampleY - mouseVelY);
+
+  // full deflection at (500 / sensitivity) counts per millisecond: 10 counts/ms at the default 50%,
+  // which is a fast flick for a 800-1600 DPI mouse
+  const float fullScale = 500.0f / std::max<uint32_t>(mouseSensitivity, 1);
+  const float magnitude = sqrtf(mouseVelX * mouseVelX + mouseVelY * mouseVelY);
+
+  float outX = 0.0f;
+  float outY = 0.0f;
+  if (magnitude > 0.03f) {
+    float normalized = std::min(1.0f, magnitude / fullScale);
+    float curved = powf(normalized, 0.7f); // more response for small movements
+    float dead = mouseDeadzone / 100.0f;
+    float shaped = dead + (1.0f - dead) * curved;
+    outX = (mouseVelX / magnitude) * shaped;
+    outY = (mouseVelY / magnitude) * shaped;
+  }
+
+  const int32_t span = GAMEPAD_JOYSTICK_MID;
+  uint16_t x = std::clamp<int32_t>(joystickMid + static_cast<int32_t>(outX * span), GAMEPAD_JOYSTICK_MIN_I32, GAMEPAD_JOYSTICK_MAX_I32);
+  uint16_t y = std::clamp<int32_t>(joystickMid + static_cast<int32_t>(outY * span), GAMEPAD_JOYSTICK_MIN_I32, GAMEPAD_JOYSTICK_MAX_I32);
+  if (mouseMovementMode == MOUSE_MOVEMENT_LEFT_ANALOG) {
+    _keyboard_host_state.lx = x;
+    _keyboard_host_state.ly = y;
+  } else {
+    _keyboard_host_state.rx = x;
+    _keyboard_host_state.ry = y;
+  }
+}
